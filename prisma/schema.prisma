generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  accessEvents         AccessEvent[]
  id                   String               @id @default(uuid()) @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  invitations          Invitation[]
  slug                 String               @unique
  name                 String
  timeZone             String               @default("UTC") @map("time_zone")
  status               String               @default("active")
  suspendedAt          DateTime?            @map("suspended_at") @db.Timestamptz(6)
  memberships          Membership[]
  customers            Customer[]
  domains              CompanyDomain[]
  platformAuditEntries PlatformAuditEntry[]
  integrations         CompanyIntegration[]
  trackedOrders        TrackedOrder[]
  pauseReasons         PauseReason[]

  @@index([createdAt(sort: Desc), id])
  @@map("companies")
}

model User {
  activatedAt           DateTime?               @map("activated_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime?               @map("password_changed_at") @db.Timestamptz(6)
  accessEvents          AccessEvent[]           @relation("AccessSubject")
  performedAccessEvents AccessEvent[]           @relation("AccessActor")
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String                  @unique
  passwordHash          String?                 @map("password_hash")
  failures              Int                     @default(0)
  blockedUntil          DateTime?               @map("blocked_until") @db.Timestamptz(6)
  memberships           Membership[]
  displayName           String?                 @map("display_name")
  phone                 String?                 @db.VarChar(16)
  isPlatformOwner       Boolean                 @default(false) @map("is_platform_owner")
  platformVersion       Int                     @default(0) @map("platform_version")
  platformSessions      PlatformSession[]
  platformOperations    PlatformOperation[]
  platformAuditEntries  PlatformAuditEntry[]
  createdInvitations    Invitation[]
  changedRoleHistory    MembershipRoleHistory[]

  @@map("users")
}

model CompanyDomain {
  hostname  String  @id
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@map("company_domains")
}

model PlatformAuditEntry {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  action      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, createdAt])
  @@map("platform_audit_log")
}

model Membership {
  accessEvents             AccessEvent[]
  id                       String                  @id @default(uuid()) @db.Uuid
  companyId                String                  @map("company_id") @db.Uuid
  userId                   String                  @map("user_id") @db.Uuid
  active                   Boolean                 @default(true)
  role                     String
  canManageCustomers       Boolean                 @default(false) @map("can_manage_customers")
  canManageFieldOperations Boolean                 @default(false) @map("can_manage_field_operations")
  transitionVersion        Int                     @default(0) @map("transition_version")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  invitations              Invitation[]
  roleHistory              MembershipRoleHistory[]
  company                  Company                 @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions                 Session[]
  customerAssignments      CustomerAssignment[]
  workdays                 Workday[]
  visits                   Visit[]
  operations               Operation[]
  auditEntries             AuditEntry[]
  trackedOrders            TrackedOrder[]
  workdayPauses            WorkdayPause[]

  @@unique([companyId, userId])
  @@unique([companyId, id])
  @@index([companyId, createdAt(sort: Desc), id])
  @@map("memberships")
}

model Session {
  tokenHash    String     @id @map("token_hash")
  companyId    String     @map("company_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sessions")
}

model PlatformSession {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_sessions")
}

model PlatformOperation {
  actorUserId String   @map("actor_user_id") @db.Uuid
  key         String
  fingerprint String
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: NoAction)

  @@id([actorUserId, key])
  @@map("platform_operations")
}

model Customer {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  name              String
  address           String
  ruc               String?
  district          String?
  zone              String?
  latitude          Float?
  longitude         Float?
  assignmentVersion Int                  @default(0) @map("assignment_version")
  company           Company              @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments       CustomerAssignment[]
  visits            Visit[]
  trackedOrders     TrackedOrder[]

  @@unique([companyId, id])
  @@unique([companyId, ruc], map: "customers_company_ruc")
  @@index([companyId, createdAt])
  @@map("customers")
}

model CustomerAssignment {
  companyId    String     @map("company_id") @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  customer     Customer   @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, customerId, membershipId])
  @@index([companyId, membershipId], map: "customers_owner")
  @@map("customer_assignments")
}

model Workday {
  id             String     @id @default(uuid()) @db.Uuid
  role           String?
  companyId      String     @map("company_id") @db.Uuid
  membershipId   String     @map("membership_id") @db.Uuid
  status         String     @default("active")
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?  @map("ended_at") @db.Timestamptz(6)
  businessDate   DateTime   @map("business_date") @db.Date
  startLatitude  Float?     @map("start_latitude")
  startLongitude Float?     @map("start_longitude")
  endLatitude    Float?     @map("end_latitude")
  endLongitude   Float?     @map("end_longitude")
  membership     Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  visits         Visit[]
  pauses         WorkdayPause[]

  @@unique([companyId, id])
  @@unique([companyId, membershipId, businessDate])
  @@unique([companyId, membershipId], where: { status: "active" }, map: "one_active_day")
  @@map("workdays")
}

model Visit {
  id                 String          @id @default(uuid()) @db.Uuid
  plannedRole        String?         @map("planned_role")
  executionRole      String?         @map("execution_role")
  version            Int             @default(0)
  stopOrder          Int?            @map("stop_order")
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?         @map("cancellation_reason")
  companyId          String          @map("company_id") @db.Uuid
  membershipId       String          @map("membership_id") @db.Uuid
  customerId         String          @map("customer_id") @db.Uuid
  scheduledAt        DateTime        @map("scheduled_at") @db.Timestamptz(6)
  workdayId          String?         @map("workday_id") @db.Uuid
  status             String          @default("pending")
  arrivedAt          DateTime?       @map("arrived_at") @db.Timestamptz(6)
  endedAt            DateTime?       @map("ended_at") @db.Timestamptz(6)
  checkInLatitude    Float?          @map("check_in_latitude")
  checkInLongitude   Float?          @map("check_in_longitude")
  result             String?
  observations       String?
  audit              Json?
  membership         Membership      @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  customer           Customer        @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  workday            Workday?        @relation(fields: [companyId, workdayId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  evidence           VisitEvidence[]

  @@unique([companyId, id])
  @@unique([companyId, membershipId, id], map: "visits_evidence_owner")
  @@unique([companyId, membershipId], where: { status: "active" }, map: "one_active_visit")
  @@index([companyId, membershipId, scheduledAt, id], map: "visits_agenda")
  @@map("visits")
}

model VisitEvidence {
  companyId    String   @map("company_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  visitId      String   @map("visit_id") @db.Uuid
  mimeType     String   @map("mime_type")
  content      Bytes
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  visit        Visit    @relation(fields: [companyId, membershipId, visitId], references: [companyId, membershipId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, visitId])
  @@map("visit_evidence")
}

model Operation {
  companyId    String     @map("company_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  key          String
  fingerprint  String
  response     Json
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, membershipId, key])
  @@map("operations")
}

model AuditEntry {
  id           BigInt     @id @default(autoincrement())
  companyId    String     @map("company_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  action       String
  details      Json?
  subjectId    String     @map("subject_id") @db.Uuid
  recordedAt   DateTime   @default(now()) @map("recorded_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_log")
}

model MembershipRoleHistory {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  membershipId    String     @map("membership_id") @db.Uuid
  previousRole    String     @map("previous_role")
  role            String
  changedAt       DateTime   @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedByUserId String     @map("changed_by_user_id") @db.Uuid
  membership      Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  changedBy       User       @relation(fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, membershipId, changedAt])
  @@map("membership_role_history")
}

model Invitation {
  purpose         String        @default("activation")
  accessEvents    AccessEvent[]
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  membershipId    String        @map("membership_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  tokenCiphertext String?       @map("token_ciphertext")
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime?     @map("consumed_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  membership      Membership    @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outbox          MailOutbox?

  @@index([companyId, membershipId, createdAt])
  @@map("invitations")
}

model MailOutbox {
  id            String     @id @default(uuid()) @db.Uuid
  invitationId  String     @unique @map("invitation_id") @db.Uuid
  status        String     @default("pending")
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedUntil   DateTime?  @map("locked_until") @db.Timestamptz(6)
  claimToken    String?    @map("claim_token")
  lastError     String?    @map("last_error")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime?  @map("sent_at") @db.Timestamptz(6)
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, nextAttemptAt])
  @@map("mail_outbox")
}

model AccessEvent {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  companyId    String?     @map("company_id") @db.Uuid
  membershipId String?     @map("membership_id") @db.Uuid
  invitationId String?     @map("invitation_id") @db.Uuid
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  event        String
  outcome      String?
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  details      Json?
  user         User?       @relation("AccessSubject", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor        User?       @relation("AccessActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership   Membership? @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, membershipId, occurredAt, id])
  @@index([invitationId, occurredAt])
  @@map("access_events")
}

model CompanyIntegration {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  provider         String
  apiKeyHash       String    @unique @map("api_key_hash")
  apiKeyPrefix     String    @map("api_key_prefix")
  hmacSecret       String?   @map("hmac_secret")
  requireSignature Boolean   @default(false) @map("require_signature")
  active           Boolean   @default(true)
  lastSyncAt       DateTime? @map("last_sync_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, provider])
  @@map("company_integrations")
}

model TrackedOrder {
  id                      String              @id @default(uuid()) @db.Uuid
  companyId               String              @map("company_id") @db.Uuid
  externalOrderId         String              @map("external_order_id")
  origin                  String              @default("brango")
  membershipId            String?             @map("membership_id") @db.Uuid
  customerId              String?             @map("customer_id") @db.Uuid
  status                  String
  originCode              String              @map("origin_code")
  linkStatus              String              @default("pending_link") @map("link_status")
  linkReason              String?             @map("link_reason")
  reportedCommercialPhone String              @map("reported_commercial_phone")
  reportedCommercialName  String?             @map("reported_commercial_name")
  reportedCustomerName    String              @map("reported_customer_name")
  reportedCustomerRuc     String?             @map("reported_customer_ruc")
  customerAddress         String?             @map("customer_address")
  district                String?
  carrierName             String?             @map("carrier_name")
  carrierPhone            String?             @map("carrier_phone")
  packagesCount           Int?                @map("packages_count")
  totalAmount             String?             @map("total_amount")
  deliveryDateLabel       String?             @map("delivery_date_label")
  notes                   String?
  evidence                Json?
  lastEventAt             DateTime            @default(now()) @map("last_event_at") @db.Timestamptz(6)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  company                 Company             @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership              Membership?         @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  customer                Customer?           @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  events                  TrackedOrderEvent[]

  @@unique([companyId, externalOrderId])
  @@index([companyId, membershipId, lastEventAt(sort: Desc)])
  @@index([companyId, status, lastEventAt(sort: Desc)])
  @@index([companyId, linkStatus, lastEventAt(sort: Desc)])
  @@map("tracked_orders")
}

model TrackedOrderEvent {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  externalEventId String?      @map("external_event_id")
  status          String
  originCode      String       @map("origin_code")
  actor           String
  note            String
  occurredAt      DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  order           TrackedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([companyId, orderId, externalEventId])
  @@index([orderId, occurredAt(sort: Asc)])
  @@map("tracked_order_events")
}

model PauseReason {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  name      String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pauses    WorkdayPause[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@map("pause_reasons")
}

model WorkdayPause {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  membershipId   String       @map("membership_id") @db.Uuid
  workdayId      String       @map("workday_id") @db.Uuid
  reasonId       String?      @map("reason_id") @db.Uuid
  reasonName     String       @map("reason_name")
  notes          String?
  status         String       @default("active")
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz(6)
  startLatitude  Float?       @map("start_latitude")
  startLongitude Float?       @map("start_longitude")
  endLatitude    Float?       @map("end_latitude")
  endLongitude   Float?       @map("end_longitude")
  membership     Membership   @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  workday        Workday      @relation(fields: [companyId, workdayId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reason         PauseReason? @relation(fields: [companyId, reasonId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, id])
  @@unique([companyId, membershipId], where: { status: "active" }, map: "one_active_pause")
  @@index([companyId, workdayId, startedAt])
  @@map("workday_pauses")
}
